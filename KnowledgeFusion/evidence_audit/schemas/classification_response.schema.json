{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classification_response.schema.json",
  "title": "Controlled evidence classification response",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "request_hash", "prompt_id", "prompt_sha256", "protocol_version", "review_model", "review_date", "classifications"],
  "properties": {
    "request_id": {"type": "string"},
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_id": {"type": "string"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_version": {"const": "7.0.0"},
    "review_model": {"type": "string", "minLength": 1},
    "review_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/classification"}
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "relevant", "direction", "entailment", "system_relevance", "study_type", "traceability", "verified_excerpt", "classification_reason"],
      "properties": {
        "mapping_id": {"type": "string", "minLength": 1},
        "relevant": {"enum": ["yes", "no"]},
        "direction": {"enum": ["support", "oppose", "mixed", "not_addressed"]},
        "entailment": {"enum": ["full", "partial", "contextual", "overreach", "none"]},
        "system_relevance": {"enum": ["direct_PBA_UOR", "PBA_only", "UOR_only", "substitution", "foundational"]},
        "study_type": {"enum": ["experimental", "computational", "review", "general_chemistry"]},
        "traceability": {"enum": ["exact_chunk_DOI_UT", "abstract_DOI_UT", "identified_record", "partition_only", "untraceable"]},
        "verified_excerpt": {"type": "string"},
        "classification_reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
