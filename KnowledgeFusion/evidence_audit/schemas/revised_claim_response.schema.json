{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revised_claim_response.schema.json",
  "title": "Revised-claim full recheck response",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "request_hash", "prompt_id", "prompt_sha256", "protocol_version", "review_model", "review_date", "source_assessments"],
  "properties": {
    "request_id": {"type": "string"},
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_id": {"type": "string"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_version": {"const": "7.0.0"},
    "review_model": {"type": "string", "minLength": 1},
    "review_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["source_packet_id", "mapping_status", "mapping_excerpt", "mapping_reason"],
        "properties": {
          "source_packet_id": {"type": "string", "minLength": 1},
          "mapping_status": {"enum": ["related", "possibly_related", "unrelated"]},
          "mapping_excerpt": {"type": "string"},
          "mapping_reason": {"type": "string", "minLength": 1},
          "relevant": {"type": "string"},
          "direction": {"type": "string"},
          "entailment": {"type": "string"},
          "system_relevance": {"type": "string"},
          "study_type": {"type": "string"},
          "traceability": {"type": "string"},
          "verified_excerpt": {"type": "string"},
          "classification_reason": {"type": "string"}
        }
      }
    }
  }
}
